<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- LIGHT MODE -->
    <Color x:Key="LightPrimary">#6C63FF</Color>
    <Color x:Key="LightPrimaryDark">#5A52D5</Color>
    <Color x:Key="LightSecondary">#FF6584</Color>
    <Color x:Key="LightBackground">#F0F2F5</Color>
    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="LightTextPrimary">#1A1A2E</Color>
    <Color x:Key="LightTextSecondary">#6B7280</Color>
    <Color x:Key="LightBorder">#E2E8F0</Color>
    <Color x:Key="LightSuccess">#22C55E</Color>
    <Color x:Key="LightError">#EF4444</Color>
    <Color x:Key="LightWarning">#F59E0B</Color>
    <Color x:Key="LightGradientStart">#6C63FF</Color>
    <Color x:Key="LightGradientEnd">#A78BFA</Color>
    <Color x:Key="LightShadow">#20000000</Color>

    <!-- DARK MODE — глубокий тёмный с фиолетовым акцентом -->
    <Color x:Key="DarkBackground">#0D0D1A</Color>
    <Color x:Key="DarkSurface">#16213E</Color>
    <Color x:Key="DarkPrimary">#A78BFA</Color>
    <Color x:Key="DarkPrimaryDark">#7C3AED</Color>
    <Color x:Key="DarkSecondary">#F472B6</Color>
    <Color x:Key="DarkTextPrimary">#F1F5F9</Color>
    <Color x:Key="DarkTextSecondary">#94A3B8</Color>
    <Color x:Key="DarkBorder">#1E293B</Color>
    <Color x:Key="DarkSuccess">#4ADE80</Color>
    <Color x:Key="DarkError">#F87171</Color>
    <Color x:Key="DarkWarning">#FBBF24</Color>
    <Color x:Key="DarkGradientStart">#16213E</Color>
    <Color x:Key="DarkGradientEnd">#0D0D1A</Color>
    <Color x:Key="DarkShadow">#60000000</Color>

    <!-- COMPATIBILITY -->
    <Color x:Key="LightAccent">#6C63FF</Color>
    <Color x:Key="DarkAccent">#A78BFA</Color>
    <Color x:Key="LightAccent1">#6C63FF</Color>
    <Color x:Key="DarkAccent1">#A78BFA</Color>
    <Color x:Key="LightAccent2">#FF6584</Color>
    <Color x:Key="DarkAccent2">#F472B6</Color>
    <Color x:Key="LightText">#1A1A2E</Color>
    <Color x:Key="DarkText">#F1F5F9</Color>

    <!-- BASIC -->
    <Color x:Key="Primary">#6C63FF</Color>
    <Color x:Key="Secondary">#FF6584</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#0F172A</Color>

</ResourceDictionary>
