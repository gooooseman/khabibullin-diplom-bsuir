<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:micro="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             xmlns:loc="clr-namespace:FinancialAssistant.UI.Markup"
             x:Class="FinancialAssistant.UI.Views.AnalyticsPage"
             Title="{loc:Translate Text=Analytics_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"
                               HorizontalOptions="Center" />

            <!-- Period Selector -->
            <Border Style="{StaticResource CardStyle}" Padding="8">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="{loc:Translate Text=Week}"
                                Command="{Binding SetPeriodWeekCommand}"
                                CornerRadius="20" HeightRequest="40" FontSize="13"
                                BackgroundColor="{Binding IsPeriodWeek, Converter={StaticResource BoolToColorConverter}}"
                                TextColor="White" />
                        <Button Grid.Column="1" Text="{loc:Translate Text=Month}"
                                Command="{Binding SetPeriodMonthCommand}"
                                CornerRadius="20" HeightRequest="40" FontSize="13"
                                BackgroundColor="{Binding IsPeriodMonth, Converter={StaticResource BoolToColorConverter}}"
                                TextColor="White" />
                        <Button Grid.Column="2" Text="{loc:Translate Text=Year}"
                                Command="{Binding SetPeriodYearCommand}"
                                CornerRadius="20" HeightRequest="40" FontSize="13"
                                BackgroundColor="{Binding IsPeriodYear, Converter={StaticResource BoolToColorConverter}}"
                                TextColor="White" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8">
                        <DatePicker Grid.Column="0" Date="{Binding CustomStartDate}" Format="dd.MM.yy"
                                    HeightRequest="40" FontSize="13" />
                        <Label Grid.Column="1" Text="—" VerticalOptions="Center" Style="{StaticResource BodyText}" />
                        <DatePicker Grid.Column="2" Date="{Binding CustomEndDate}" Format="dd.MM.yy"
                                    HeightRequest="40" FontSize="13" />
                        <Button Grid.Column="3" Text="▶" Command="{Binding ApplyCustomRangeCommand}"
                                CornerRadius="8" HeightRequest="40" WidthRequest="44" FontSize="14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"
                                TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Summary Cards -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSuccess}, Dark={StaticResource DarkSuccess}}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{loc:Translate Text=Analytics_Incomes}" FontSize="11" TextColor="White" Opacity="0.85" />
                        <Label Text="{Binding TotalIncomeFormatted}" FontSize="13" FontAttributes="Bold"
                               TextColor="White" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{loc:Translate Text=Analytics_Expenses}" FontSize="11" TextColor="White" Opacity="0.85" />
                        <Label Text="{Binding TotalExpenseFormatted}" FontSize="13" FontAttributes="Bold"
                               TextColor="White" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10"
                        BackgroundColor="{Binding BalanceColor}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{loc:Translate Text=Analytics_Balance}" FontSize="11" TextColor="White" Opacity="0.85" />
                        <Label Text="{Binding BalanceFormatted}" FontSize="13" FontAttributes="Bold"
                               TextColor="White" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- No Data -->
            <Border Style="{StaticResource CardStyle}" IsVisible="{Binding HasNoData}">
                <Label Text="{loc:Translate Text=Analytics_NoData}" HorizontalOptions="Center"
                       Style="{StaticResource SubHeadline}" Margin="0,16" />
            </Border>

            <!-- Chart Section -->
            <Border Style="{StaticResource CardStyle}" IsVisible="{Binding HasNoData, Converter={StaticResource InverseBoolConverter}}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:Translate Text=Analytics_Dynamics}" FontAttributes="Bold"
                               Style="{StaticResource SubHeadline}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{Binding ChartTypeLabel}"
                                Command="{Binding ToggleChartTypeCommand}"
                                CornerRadius="14" HeightRequest="32" FontSize="12" Padding="10,0"
                                BackgroundColor="Transparent" BorderWidth="1"
                                BorderColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"
                                TextColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}" />
                    </Grid>

                    <!-- Category filter for expense chart -->
                    <Border IsVisible="{Binding IsCategoryFilterVisible}"
                            Padding="4,2" StrokeShape="RoundRectangle 10"
                            Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                            StrokeThickness="1">
                        <Picker ItemsSource="{Binding CategoryFilters}"
                                SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                                ItemDisplayBinding="{Binding Name}"
                                Title="{loc:Translate Text=Analytics_FilterTitle}"
                                FontSize="13"
                                HeightRequest="40" />
                    </Border>

                    <micro:ChartView Chart="{Binding TimeSeriesChart}" HeightRequest="200" />
                </VerticalStackLayout>
            </Border>

            <!-- Categories Section -->
            <Border Style="{StaticResource CardStyle}" IsVisible="{Binding HasNoData, Converter={StaticResource InverseBoolConverter}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate Text=Analytics_ByCategories}" FontAttributes="Bold" Style="{StaticResource SubHeadline}" />
                    <micro:ChartView Chart="{Binding CategoryChart}" HeightRequest="180" />

                    <!-- Table header -->
                    <Grid ColumnDefinitions="14,*,Auto,Auto,Auto" ColumnSpacing="8" Padding="0,4,0,2">
                        <Label Grid.Column="1" Text="{loc:Translate Text=Analytics_CategoryCol}"
                               FontSize="11" FontAttributes="Bold" Style="{StaticResource CaptionText}" />
                        <Label Grid.Column="2" Text="{loc:Translate Text=Analytics_AmountCol}"
                               FontSize="11" FontAttributes="Bold" Style="{StaticResource CaptionText}" HorizontalOptions="End" />
                        <Label Grid.Column="3" Text="{loc:Translate Text=Analytics_PctCol}"
                               FontSize="11" FontAttributes="Bold" Style="{StaticResource CaptionText}" HorizontalOptions="End" />
                        <Label Grid.Column="4" Text="{loc:Translate Text=Analytics_TrendCol}"
                               FontSize="11" FontAttributes="Bold" Style="{StaticResource CaptionText}" HorizontalOptions="End" />
                    </Grid>

                    <!-- Thin divider -->
                    <BoxView HeightRequest="1" Margin="0,0,0,4"
                             Color="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" />

                    <!-- Category rows -->
                    <CollectionView ItemsSource="{Binding CategoryBreakdowns}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="14,*,Auto,Auto,Auto" ColumnSpacing="8" Padding="0,6">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToCategoryDetailCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <BoxView Grid.Column="0" WidthRequest="10" HeightRequest="10"
                                             CornerRadius="5" VerticalOptions="Center"
                                             Color="{Binding Category.Color}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="{Binding Category.Name}" FontSize="13" Style="{StaticResource BodyText}" />
                                        <ProgressBar Progress="{Binding ProgressValue}"
                                                     ProgressColor="{Binding Category.Color}"
                                                     HeightRequest="4" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Amount, StringFormat='{0:N0}'}"
                                           FontSize="13" FontAttributes="Bold" Style="{StaticResource BodyText}"
                                           VerticalOptions="Center" HorizontalOptions="End" />
                                    <Label Grid.Column="3" Text="{Binding Percentage, StringFormat='{0:N0}%'}"
                                           FontSize="12" Style="{StaticResource CaptionText}"
                                           VerticalOptions="Center" HorizontalOptions="End" />
                                    <VerticalStackLayout Grid.Column="4" Spacing="1"
                                                         VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding Trend, Converter={StaticResource TrendIconConverter}}"
                                               FontSize="13" FontAttributes="Bold"
                                               TextColor="{Binding Trend, Converter={StaticResource TrendColorConverter}}"
                                               HorizontalOptions="End" />
                                        <Label Text="{Binding TrendPercent, Converter={StaticResource TrendPercentFormatter}}"
                                               FontSize="10"
                                               TextColor="{Binding Trend, Converter={StaticResource TrendColorConverter}}"
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="{loc:Translate Text=Analytics_NoCategoryData}"
                                   HorizontalOptions="Center" Style="{StaticResource CaptionText}" Margin="0,8" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Forecast Section -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate Text=Analytics_ForecastTitle}" FontAttributes="Bold" Style="{StaticResource SubHeadline}" />
                    <Label Text="{Binding ForecastHint}" Style="{StaticResource CaptionText}" />
                    <Button Text="{loc:Translate Text=Analytics_ForecastButton}"
                            Command="{Binding CalculateForecastCommand}"
                            Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsForecastAvailable}" />
                    <CollectionView ItemsSource="{Binding ForecastResults}" SelectionMode="None"
                                    IsVisible="{Binding IsForecastVisible}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,5" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="{Binding Category.Name}"
                                           Style="{StaticResource BodyText}" FontSize="14" VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding PredictedAmount, StringFormat='{0:N0}'}"
                                           Style="{StaticResource BodyText}" FontSize="14"
                                           FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
