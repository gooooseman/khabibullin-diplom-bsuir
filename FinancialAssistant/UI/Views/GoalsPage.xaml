<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinancialAssistant.UI.ViewModels"
             xmlns:loc="clr-namespace:FinancialAssistant.UI.Markup"
             x:Class="FinancialAssistant.UI.Views.GoalsPage"
             Title="{Binding Title}">

    <Grid RowDefinitions="*, Auto">
        <CollectionView Grid.Row="0" ItemsSource="{Binding Goals}" SelectionMode="None" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,5" Padding="10" StrokeShape="RoundRectangle 8" Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}" StrokeThickness="1">
                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="16"/>
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Deadline, StringFormat='{0:dd MMM yyyy}'}" FontSize="12" TextColor="Gray" HorizontalOptions="End"/>
                            
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Progress="{Binding ProgressPercentage, Mode=OneWay}" ProgressColor="{AppThemeBinding Light={StaticResource LightAccent1}, Dark={StaticResource DarkAccent1}}" Margin="0,10"/>
                            
                            <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Spacing="5">
                                <Label Text="{Binding CurrentAmount, StringFormat='{0:N0}'}" TextColor="{AppThemeBinding Light={StaticResource LightAccent1}, Dark={StaticResource DarkAccent1}}" FontAttributes="Bold"/>
                                <Label Text="/" TextColor="Gray"/>
                                <Label Text="{Binding TargetAmount, StringFormat='{0:N0}'}" TextColor="Gray"/>
                            </HorizontalStackLayout>
                            
                            <Button Grid.Row="2" Grid.Column="1" Text="{loc:Translate Text=AddFunds}" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:GoalsViewModel}}, Path=UpdateGoalCommand}" CommandParameter="{Binding .}" FontSize="12" HeightRequest="30" Padding="10,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="{loc:Translate Text=EmptyGoals}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray"/>
            </CollectionView.EmptyView>
        </CollectionView>

        <Button Grid.Row="1" Text="{loc:Translate Text=AddGoal}" Command="{Binding AddGoalCommand}" Margin="20" BackgroundColor="{AppThemeBinding Light={StaticResource LightAccent1}, Dark={StaticResource DarkAccent1}}" TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkText}}" CornerRadius="20"/>
    </Grid>
</ContentPage>

