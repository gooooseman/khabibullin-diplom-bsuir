<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:FinancialAssistant.UI.Markup"
             x:Class="FinancialAssistant.UI.Views.RegisterPage"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="30" VerticalOptions="Center">

            <Label Text="{loc:Translate Text=Register}" FontSize="32" FontAttributes="Bold"
                   HorizontalOptions="Center" Style="{StaticResource Headline1}"/>

            <Border StrokeShape="RoundRectangle 10" Padding="0">
                <Entry Text="{Binding DisplayName}" Placeholder="Имя"
                       HeightRequest="50" Margin="10,0"/>
            </Border>

            <Border StrokeShape="RoundRectangle 10" Padding="0">
                <Entry Text="{Binding Email}" Placeholder="Email" Keyboard="Email"
                       HeightRequest="50" Margin="10,0"/>
            </Border>

            <Border StrokeShape="RoundRectangle 10" Padding="0">
                <Entry Text="{Binding Password}" IsPassword="True"
                       Placeholder="{loc:Translate Text=Password}"
                       HeightRequest="50" Margin="10,0"/>
            </Border>

            <Border StrokeShape="RoundRectangle 10" Padding="0">
                <Entry Text="{Binding ConfirmPassword}" IsPassword="True"
                       Placeholder="{loc:Translate Text=ConfirmPassword}"
                       HeightRequest="50" Margin="10,0"/>
            </Border>

            <Button Text="{loc:Translate Text=Register}"
                    Command="{Binding RegisterCommand}"
                    Style="{StaticResource PrimaryButton}"/>

            <Button Text="Уже есть аккаунт? Войти"
                    Command="{Binding GoToLoginCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
