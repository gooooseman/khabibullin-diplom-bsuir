<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinancialAssistant.UI.ViewModels"
             xmlns:loc="clr-namespace:FinancialAssistant.UI.Markup"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="FinancialAssistant.UI.Views.AddGoalPage"
             x:DataType="viewmodels:AddGoalViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="{loc:Translate Text=GoalName}" Style="{StaticResource SubHeaderLabel}"/>
        <Entry Text="{Binding Name}" Placeholder="Например: Отпуск" />

        <Label Text="{loc:Translate Text=TargetAmount}" Style="{StaticResource SubHeaderLabel}"/>
        <Entry Text="{Binding TargetAmount}" Keyboard="Numeric" Placeholder="0.00" />

        <Label Text="{loc:Translate Text=CurrentSavings}" Style="{StaticResource SubHeaderLabel}"/>
        <Entry Text="{Binding CurrentAmount}" Keyboard="Numeric" Placeholder="0.00" />

        <Label Text="{loc:Translate Text=Deadline}" Style="{StaticResource SubHeaderLabel}"/>
        <DatePicker Date="{Binding Deadline}" 
                    Format="dd MMM yyyy" 
                    MinimumDate="{x:Static sys:DateTime.Today}" 
                    TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" 
                    HeightRequest="50"/>

        <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,20,0,0">
            <Button Grid.Column="0" Text="{loc:Translate Text=Cancel}" Command="{Binding CancelCommand}" BackgroundColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" TextColor="White"/>
            <Button Grid.Column="1" Text="{loc:Translate Text=Save}" Command="{Binding SaveCommand}" BackgroundColor="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}" TextColor="White"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>

