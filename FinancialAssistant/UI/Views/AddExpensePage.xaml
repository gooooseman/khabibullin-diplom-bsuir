<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinancialAssistant.UI.ViewModels"
             xmlns:loc="clr-namespace:FinancialAssistant.UI.Markup"
             x:Class="FinancialAssistant.UI.Views.AddExpensePage"
             x:DataType="viewmodels:AddExpenseViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="{loc:Translate Text=Amount}" Style="{StaticResource SubHeaderLabel}"/>
        <Grid ColumnDefinitions="*, Auto">
            <Entry Grid.Column="0" Text="{Binding Amount}" Keyboard="Numeric" Placeholder="0.00" />
            <Picker Grid.Column="1" ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}"
                    WidthRequest="90" HeightRequest="50" Margin="8,0,0,0"/>
        </Grid>

        <Label Text="{loc:Translate Text=Category}" Style="{StaticResource SubHeaderLabel}"/>
        <Grid ColumnDefinitions="*, Auto">
            <Picker Grid.Column="0" 
                    ItemsSource="{Binding Categories}" 
                    ItemDisplayBinding="{Binding Name}" 
                    SelectedItem="{Binding SelectedCategory}" 
                    Title="Выберите категорию" 
                    TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" 
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" 
                    HeightRequest="50" 
                    TitleColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"/>
            <Button Grid.Column="1" Text="+" Command="{Binding AddCategoryCommand}" WidthRequest="50" HeightRequest="50" CornerRadius="16" Margin="10,0,0,0"/>
        </Grid>

        <Label Text="{loc:Translate Text=Date}" Style="{StaticResource SubHeaderLabel}"/>
        <DatePicker Date="{Binding Date}" Format="dd MMM yyyy" TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" HeightRequest="50"/>

        <Label Text="{loc:Translate Text=CommentOptional}" Style="{StaticResource SubHeaderLabel}"/>
        <Entry Text="{Binding Comment}" Placeholder="Примечание" />
        
        <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,20,0,0">
            <Button Grid.Column="0" Text="{loc:Translate Text=Cancel}" Command="{Binding CancelCommand}" BackgroundColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}" TextColor="White"/>
            <Button Grid.Column="1" Text="{loc:Translate Text=Save}" Command="{Binding SaveCommand}" BackgroundColor="{AppThemeBinding Light={StaticResource LightAccent}, Dark={StaticResource DarkAccent}}" TextColor="White"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>

