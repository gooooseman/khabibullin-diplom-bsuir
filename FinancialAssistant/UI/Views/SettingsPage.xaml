<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:FinancialAssistant.UI.Markup"
             x:Class="FinancialAssistant.UI.Views.SettingsPage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Profile link -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{loc:Translate Text=Profile}" FontAttributes="Bold" Style="{StaticResource BodyText}"/>
                        <Label Text="{loc:Translate Text=PremiumStatus}" Style="{StaticResource CaptionText}"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="›" FontSize="22" BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"
                            Command="{Binding GoToProfileCommand}" />
                </Grid>
            </Border>

            <!-- Dark Mode -->
            <Border Style="{StaticResource CardStyle}">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="{loc:Translate Text=DarkMode}" VerticalOptions="Center"
                           HorizontalOptions="StartAndExpand" Style="{StaticResource BodyText}"/>
                    <Switch IsToggled="{Binding IsDarkMode}"
                            OnColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Language -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Text=Language}" FontAttributes="Bold" Style="{StaticResource BodyText}"/>
                    <Picker ItemsSource="{Binding Languages}"
                            SelectedItem="{Binding SelectedLanguage}"
                            ItemDisplayBinding="{Binding DisplayName}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Currency -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Text=Currency}" FontAttributes="Bold" Style="{StaticResource BodyText}"/>
                    <Picker ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}"/>
                </VerticalStackLayout>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Translate Text=About}" FontAttributes="Bold" Style="{StaticResource BodyText}"/>
                    <Label Text="{loc:Translate Text=AppVersion}" Style="{StaticResource CaptionText}"/>
                    <Label Text="{loc:Translate Text=BuiltWithMaui}" Style="{StaticResource CaptionText}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Debug Mode -->
            <Border Style="{StaticResource CardStyle}"
                    BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#3E2723}">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="🛠" FontSize="20"/>
                        <Label Text="Debug Mode" FontAttributes="Bold" FontSize="18"
                               Style="{StaticResource BodyText}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Label Text="Выберите период и добавьте тестовые данные для проверки аналитики и ML-прогноза"
                           Style="{StaticResource CaptionText}"/>

                    <!-- Period picker -->
                    <Border Padding="4,2" StrokeShape="RoundRectangle 10"
                            Stroke="{AppThemeBinding Light={StaticResource LightBorder}, Dark={StaticResource DarkBorder}}"
                            StrokeThickness="1">
                        <Picker ItemsSource="{Binding DataPeriods}"
                                SelectedItem="{Binding SelectedDataPeriod, Mode=TwoWay}"
                                ItemDisplayBinding="{Binding DisplayName}"
                                Title="Период данных"
                                FontSize="14"
                                HeightRequest="44" />
                    </Border>

                    <Button Text="📊 Добавить тестовые данные"
                            Command="{Binding GenerateTestDataCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"
                            TextColor="White" CornerRadius="10"/>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Primary}"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
