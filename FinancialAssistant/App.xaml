<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FinancialAssistant"
             xmlns:converters="clr-namespace:FinancialAssistant.UI.Converters"
             xmlns:vmconverters="clr-namespace:FinancialAssistant.UI.ViewModels"
             x:Class="FinancialAssistant.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:SeverityColorConverter x:Key="SeverityColorConverter" />
            <converters:StringIsNotNullOrEmptyConverter x:Key="StringIsNotNullOrEmptyConverter" />
            <vmconverters:InvertedBoolConverter x:Key="InverseBoolConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:TrendIconConverter x:Key="TrendIconConverter" />
            <converters:TrendColorConverter x:Key="TrendColorConverter" />
            <converters:TrendPercentFormatter x:Key="TrendPercentFormatter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
